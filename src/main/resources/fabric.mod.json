	"description": "Adds a configurable timer to the disconnect button. inspired by MCSR Ranked",
	"authors": [
		"ThatCuteOne"
	],
    "custom": {
      "modmenu": {
        "links": {
          "modmenu.discord": "https://discord.gg/ErtF2jJWQN"
        }
      }
    },
	"contact": {
		"sources": "https://github.com/ThatCuteOne/disconnect-timer-mod",
        "issues": "https://github.com/ThatCuteOne/disconnect-timer-mod",
		"website": "https://modrinth.com/mod/disconnect-timer"
	},
	"license": "GPL-3.0",
	"icon": "assets/disconnect-timer/icon.png",
